# Copier en .env.prod, remplir, puis (voir le README, section "Déploiement en production") :
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build -d
#
# C'est le mode "standalone" (par défaut) : l'app gère elle-même son HTTPS via Caddy, intégré
# directement au conteneur "frontend" (DOMAIN / ACME_EMAIL ci-dessous). À utiliser si l'app est
# seule sur le serveur.
#
# Pour s'appuyer à la place sur un Caddy déjà présent sur l'hôte, partagé par plusieurs apps,
# ajouter l'overlay docker-compose.prod.proxy.yml :
#
#   docker compose -f docker-compose.prod.yml -f docker-compose.prod.proxy.yml --env-file .env.prod up --build -d
#
# Dans ce mode "proxy", l'app est atteinte via un réseau Docker externe (PROXY_NETWORK_NAME
# ci-dessous) ; DOMAIN et ACME_EMAIL sont alors inutiles, c'est le Caddyfile de l'hôte qui
# déclare le domaine et gère le certificat — voir le guide de déploiement dans le README.
#
# Dans les deux cas, le domaine public choisi doit correspondre à DJANGO_ALLOWED_HOSTS,
# CORS_ALLOWED_ORIGINS, CSRF_TRUSTED_ORIGINS et FRONTEND_URL ci-dessous.

# --- Mode standalone (par défaut) uniquement ---
# Domaine public sur lequel Caddy obtiendra un certificat Let's Encrypt.
DOMAIN=cocotte.example.org
# Email transmis à Let's Encrypt (notifications d'expiration/renouvellement).
ACME_EMAIL=admin@example.org

# --- Mode proxy externe uniquement (overlay docker-compose.prod.proxy.yml) ---
# Nom du réseau Docker externe sur lequel se trouve le Caddy partagé de l'hôte (doit déjà
# exister : `docker network create <nom>`).
PROXY_NETWORK_NAME=proxy

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=cocotte.example.org
CORS_ALLOWED_ORIGINS=https://cocotte.example.org
CSRF_TRUSTED_ORIGINS=https://cocotte.example.org

# Base de données (le mot de passe est aussi utilisé par le service "db" ci-dessus)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@db:5432/cocotte

# Emails (réinitialisation de mot de passe). Sans ceci, EMAIL_BACKEND reste la console
# du conteneur backend : les liens de réinitialisation ne partiront jamais vraiment.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Cocotte <noreply@cocotte.example.org>

# --- Relais Postfix intégré (profil "mail", optionnel) ---
# Pour l'utiliser, remplacer les variables EMAIL_* ci-dessus par :
#   EMAIL_HOST=mail
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=
#   EMAIL_HOST_PASSWORD=
#   EMAIL_USE_TLS=False
# et lancer le stack avec `--profile mail`. Voir la doc de configuration pour les DNS à créer.
# Domaine d'envoi (celui de DEFAULT_FROM_EMAIL).
MAIL_DOMAIN=cocotte.example.org
# Nom d'hôte annoncé par Postfix ; doit correspondre au reverse DNS (PTR) de l'IP du serveur.
MAIL_HOSTNAME=mail.cocotte.example.org
# Optionnel : relayer via un fournisseur SMTP au lieu de livrer en direct.
# MAIL_RELAYHOST=[smtp-relay.brevo.com]:587
# MAIL_RELAYHOST_USERNAME=
# MAIL_RELAYHOST_PASSWORD=

# Utilisé pour construire le lien envoyé par email (doit pointer vers le domaine public).
FRONTEND_URL=https://cocotte.example.org
