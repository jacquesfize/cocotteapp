# Copier en .env.prod, remplir, puis : docker compose -f docker-compose.prod.yml up --build -d

# Domaine sur lequel l'app sera exposée et adresse pour le compte Let's Encrypt (HTTPS
# automatique via Caddy). Le domaine doit déjà pointer (DNS A/AAAA) vers ce serveur.
DOMAIN=cocotte.example.org
ACME_EMAIL=admin@example.org

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=cocotte.example.org
CORS_ALLOWED_ORIGINS=https://cocotte.example.org
CSRF_TRUSTED_ORIGINS=https://cocotte.example.org

# Base de données (le mot de passe est aussi utilisé par le service "db" ci-dessus)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@db:5432/cocotte

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0

# Emails (réinitialisation de mot de passe). Sans ceci, EMAIL_BACKEND reste la console
# du conteneur backend : les liens de réinitialisation ne partiront jamais vraiment.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Cocotte <noreply@cocotte.example.org>

# Utilisé pour construire le lien envoyé par email (doit pointer vers le domaine public).
FRONTEND_URL=https://cocotte.example.org
