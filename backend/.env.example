DJANGO_SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://postgres:postgres@db:5432/cocotte
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Emails (réinitialisation de mot de passe) : laisser EMAIL_BACKEND tel quel en dev,
# les emails s'affichent alors dans la console au lieu d'être envoyés.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Cocotte <noreply@example.org>
FRONTEND_URL=http://localhost:5173

